get_filename_component(executable_directory "${EXECUTABLE}" DIRECTORY)
set(log "${executable_directory}/VanillaBTN.log")

foreach(run RANGE 1 2)
    execute_process(COMMAND "${EXECUTABLE}" RESULT_VARIABLE result)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "VanillaBTN run ${run} failed (${result}).")
    endif()

    if(BUILD_CONFIG STREQUAL "Debug")
        file(STRINGS "${log}" entries)
        list(LENGTH entries count)
        set(timestamp "^[0-9]+-[0-9]+-[0-9]+T[0-9]+:[0-9]+:[0-9]+")
        if(NOT count EQUAL 1 OR NOT entries MATCHES "${timestamp} INFO startup VanillaBTN initialized$")
            message(FATAL_ERROR "Debug must rewrite a single timestamped startup line on each run.")
        endif()
    elseif(EXISTS "${log}")
        message(FATAL_ERROR "Release created a log file.")
    endif()
endforeach()

execute_process(COMMAND "${EXECUTABLE}" --import-disc RESULT_VARIABLE result
    ERROR_VARIABLE diagnostic)
if(NOT result STREQUAL "2" OR NOT diagnostic MATCHES "Usage: vanillabtn")
    message(FATAL_ERROR "The import option must report a missing disc argument.")
endif()

if(HAS_GAME)
    set(invalid_disc "${CMAKE_CURRENT_BINARY_DIR}/smoke_invalid_disc")
    file(WRITE "${invalid_disc}" "Invalid reference image")
    execute_process(COMMAND "${EXECUTABLE}" --disc "${invalid_disc}" RESULT_VARIABLE result
        ERROR_VARIABLE diagnostic TIMEOUT 15)
    file(REMOVE "${invalid_disc}")
    if(NOT result STREQUAL "1" OR NOT diagnostic MATCHES "does not match the USA reference SHA-1")
        message(FATAL_ERROR "A mismatched disc must be rejected before boot.")
    endif()
    if(BUILD_CONFIG STREQUAL "Release")
        execute_process(COMMAND "${EXECUTABLE}" --disc unused --debug-menu RESULT_VARIABLE result
            ERROR_VARIABLE diagnostic)
        if(NOT result STREQUAL "2" OR NOT diagnostic MATCHES "Usage: vanillabtn")
            message(FATAL_ERROR "Release must not expose --debug-menu.")
        endif()
    endif()
endif()

if(HAS_GAME)
    string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef id)
    set(package "${CMAKE_CURRENT_BINARY_DIR}/startup-smoke-${id}")
    get_filename_component(executable_name "${EXECUTABLE}" NAME)
    file(MAKE_DIRECTORY "${package}")
    file(GLOB runtime "${executable_directory}/clang_rt.asan_dynamic-x86_64.dll")
    file(COPY "${EXECUTABLE}" ${runtime} DESTINATION "${package}")
    file(COPY "${executable_directory}/tools/psx_disc.py" DESTINATION "${package}/tools")
    file(COPY "${executable_directory}/disc/disc.sha1" DESTINATION "${package}/disc")
    set(launcher "${package}/${executable_name}")
    set(image "${package}/disc image.ISO")
    set(descriptor "${package}/disc descriptor.CUE")

    file(WRITE "${image}" "Invalid reference image")
    execute_process(COMMAND "${launcher}" RESULT_VARIABLE auto_result
        ERROR_VARIABLE auto_error TIMEOUT 15)
    execute_process(COMMAND "${launcher}" "${image}" RESULT_VARIABLE drop_result
        ERROR_VARIABLE drop_error TIMEOUT 15)
    execute_process(COMMAND "${launcher}" --install RESULT_VARIABLE install_result
        ERROR_VARIABLE install_error TIMEOUT 15)
    file(WRITE "${descriptor}" "Invalid CUE")
    execute_process(COMMAND "${launcher}" RESULT_VARIABLE cue_result
        ERROR_VARIABLE cue_error TIMEOUT 15)
    file(WRITE "${package}/other.cue" "Another invalid CUE")
    execute_process(COMMAND "${launcher}" RESULT_VARIABLE multiple_result
        ERROR_VARIABLE multiple_error TIMEOUT 15)
    file(REMOVE_RECURSE "${package}")

    if(NOT auto_result STREQUAL "1" OR NOT auto_error MATCHES "does not match the USA reference SHA-1")
        message(FATAL_ERROR "Auto launch must verify the adjacent ISO image.")
    endif()
    if(NOT drop_result STREQUAL "1" OR NOT drop_error MATCHES "not a MODE2/2352 image")
        message(FATAL_ERROR "A bare disc path must use the verified importer.")
    endif()
    if(NOT install_result STREQUAL "1" OR NOT install_error MATCHES "not a MODE2/2352 image")
        message(FATAL_ERROR "--install must verify the adjacent image before extracting.")
    endif()
    if(NOT cue_result STREQUAL "1" OR NOT cue_error MATCHES "Expected one MODE2/2352 CUE track")
        message(FATAL_ERROR "Auto launch must prefer the adjacent CUE.")
    endif()
    if(NOT multiple_result STREQUAL "1" OR NOT multiple_error MATCHES "Use --disc PATH")
        message(FATAL_ERROR "Auto launch must report ambiguous disc selection.")
    endif()
endif()
