# Native-only wrappers expose each TU's real objects without changing matching C
# or copying linker ranges that contain ASan redzones.
file(REAL_PATH "${CMAKE_CURRENT_SOURCE_DIR}/.." hm_inventory_root)
file(GLOB_RECURSE hm_inventory_headers CONFIGURE_DEPENDS
    "${hm_inventory_root}/src/*.h" "${hm_inventory_root}/port/compat/*.h"
    "${hm_inventory_root}/port/compat/*.inc")
list(SORT hm_inventory_headers)
set(hm_inventory_header_text "")
foreach(header IN LISTS hm_inventory_headers)
    file(RELATIVE_PATH relative "${hm_inventory_root}" "${header}")
    file(READ "${header}" content)
    string(REPLACE "\r\n" "\n" content "${content}")
    string(SHA256 digest "${content}")
    string(APPEND hm_inventory_header_text "${relative} ${digest}\n")
endforeach()
string(SHA256 hm_inventory_header_digest "${hm_inventory_header_text}")
function(hm_farm_state_headers expected)
    if(NOT hm_inventory_header_digest STREQUAL expected)
        message(FATAL_ERROR "Farm state inventory headers changed; re-audit with port/analysis/inventory_farm_state.py")
    endif()
endfunction()
set(hm_canonical_game_sources)
foreach(source IN LISTS hm_game_sources)
    file(REAL_PATH "${source}" source)
    list(APPEND hm_canonical_game_sources "${source}")
endforeach()
set(hm_game_sources ${hm_canonical_game_sources})
set(hm_farm_inventory_units)
set(hm_farm_wrapped_originals)
set(hm_farm_seen_sources)
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/native_farm")
function(hm_farm_state_unit relative expected)
    set(original "${hm_inventory_root}/src/overlay/11_GF_FARM/${relative}")
    file(READ "${original}" content)
    string(REPLACE "\r\n" "\n" content "${content}")
    string(SHA256 digest "${content}")
    if(NOT digest STREQUAL expected)
        message(FATAL_ERROR "Farm state inventory changed: ${relative}; re-audit with port/analysis/inventory_farm_state.py")
    endif()
    list(APPEND hm_farm_seen_sources "${original}")
    set(hm_farm_seen_sources ${hm_farm_seen_sources} PARENT_SCOPE)
    string(REGEX REPLACE "[^A-Za-z0-9_]" "_" identifier "${relative}")
    set(inventory "${CMAKE_CURRENT_SOURCE_DIR}/overlay/farm_state/${identifier}.inc")
    if(EXISTS "${inventory}")
        set(wrapper "${CMAKE_CURRENT_BINARY_DIR}/native_farm/${identifier}.c")
        file(CONFIGURE OUTPUT "${wrapper}" CONTENT
            "/* Native overlay state inventory; matching source stays read-only. */\n#include \"${original}\"\n#include \"${inventory}\"\n" @ONLY)
        list(FIND hm_game_sources "${original}" source_index)
        list(REMOVE_AT hm_game_sources ${source_index})
        list(INSERT hm_game_sources ${source_index} "${wrapper}")
        list(APPEND hm_farm_wrapped_originals "${original}")
        string(APPEND hm_farm_inventory_units "HM_FARM_UNIT(${identifier})\n")
        set_source_files_properties("${original}" PROPERTIES HM_NATIVE_WRAPPER "${wrapper}")
        set(hm_game_sources ${hm_game_sources} PARENT_SCOPE)
        set(hm_farm_wrapped_originals ${hm_farm_wrapped_originals} PARENT_SCOPE)
        set(hm_farm_inventory_units "${hm_farm_inventory_units}" PARENT_SCOPE)
    endif()
endfunction()
include("${CMAKE_CURRENT_SOURCE_DIR}/overlay/farm_state/manifest.cmake")
file(GLOB_RECURSE hm_farm_actual_sources CONFIGURE_DEPENDS "${hm_inventory_root}/src/overlay/11_GF_FARM/*.c")
list(SORT hm_farm_actual_sources)
list(SORT hm_farm_seen_sources)
if(NOT hm_farm_actual_sources STREQUAL hm_farm_seen_sources)
    message(FATAL_ERROR "Farm translation units changed; re-audit the state inventory")
endif()
file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/native_farm/farm_units.inc"
    CONTENT "${hm_farm_inventory_units}" @ONLY)
