# Keep unsupported SDK calls explicit and confined to the audited call sites.
cmake_minimum_required(VERSION 3.24)
file(READ "${ROOT}/port/psx/pending.c" pending)
set(allowed FntFlush FntLoad FntOpen FntPrint KanjiFntClose KanjiFntFlush
    KanjiFntOpen KanjiFntPrint SetDumpFnt)
string(REGEX MATCHALL "hm_unimplemented\\(\"[A-Za-z0-9_]+\"\\)" traps "${pending}")
set(actual)
foreach(trap IN LISTS traps)
    string(REGEX REPLACE "hm_unimplemented\\(\"([A-Za-z0-9_]+)\"\\)" "\\1" name "${trap}")
    if(NOT name IN_LIST allowed)
        message(FATAL_ERROR "New unsupported SDK call: ${name}")
    endif()
    list(APPEND actual "${name}")
endforeach()
list(LENGTH actual count)
if(NOT count EQUAL 9)
    message(FATAL_ERROR "Pending API inventory changed; update the audited inventory")
endif()
set(sample "src/overlay/10_PdaSamp/pdasamp.c")
set(swind "src/overlay/30_GF_swind/swind.c")
set(debug "src/overlay/08_DEBUG/debug.c")
set(FntFlush "${sample};${swind}")
set(FntLoad "${sample};${swind}")
set(FntOpen "${sample};${swind}")
set(FntPrint "${sample};${swind};${debug};src/main/graphics/anim.c;src/overlay/11_GF_FARM/event/event_commands.c;src/overlay/31_gf_mcard/mcard.c")
foreach(name KanjiFntClose KanjiFntFlush KanjiFntOpen KanjiFntPrint)
    set(${name} "${debug};${swind}")
endforeach()
set(SetDumpFnt "${sample};${swind}")
file(GLOB_RECURSE sources RELATIVE "${ROOT}" "${ROOT}/src/*.c")
foreach(source IN LISTS sources)
    file(READ "${ROOT}/${source}" content)
    foreach(name IN LISTS actual)
        if(content MATCHES "(^|[^A-Za-z0-9_])${name}[ \t\r\n]*\\(")
            if(NOT source IN_LIST ${name})
                message(FATAL_ERROR "Unsupported ${name} reached new source: ${source}")
            endif()
        endif()
    endforeach()
endforeach()
message(STATUS "Nine debug-font APIs remain explicit; no new source call sites")
